#!/usr/bin/env bash
set -euo pipefail

AGENT_ROUTER_HOME="${AGENT_ROUTER_HOME:-$HOME/.agent-router}"
VERSION_URL="${AGENT_ROUTER_VERSION_URL:-https://raw.githubusercontent.com/st-devl/Global_Router_codex/HEAD/VERSION}"
MIN_SKILLS="${AGENT_ROUTER_MIN_SKILLS:-10}"
ok=1

pass() { printf '%s: OK\n' "$1"; }
fail() { printf '%s: FAIL\n' "$1"; ok=0; }
skip() { printf '%s: SKIPPED (%s)\n' "$1" "$2"; }

local_version() {
  if [ -f "$AGENT_ROUTER_HOME/VERSION" ]; then
    tr -d '[:space:]' < "$AGENT_ROUTER_HOME/VERSION"
  else
    printf 'unknown'
  fi
}

check_version() {
  local local latest
  local="$(local_version)"
  printf 'Version local: %s\n' "$local"

  if [ "${AGENT_ROUTER_OFFLINE:-0}" = "1" ]; then
    skip "Version remote" "offline mode"
    return
  fi

  if ! command -v curl >/dev/null 2>&1; then
    skip "Version remote" "no curl"
    return
  fi

  latest="$(curl -fsSL "${VERSION_URL}?t=$(date +%s)" 2>/dev/null | tr -d '[:space:]' || true)"
  if [ -z "$latest" ]; then
    skip "Version remote" "network unavailable"
    return
  fi

  printf 'Version remote: %s\n' "$latest"
  if [ "$local" = "$latest" ]; then
    pass "Version"
  else
    printf 'Update: curl -fsSL https://raw.githubusercontent.com/st-devl/Global_Router_codex/main/install.sh | bash\n'
    fail "Version"
  fi
}

check_installation() {
  [ -x "$AGENT_ROUTER_HOME/router.py" ] && pass "router.py" || fail "router.py"

  if python3 - "$AGENT_ROUTER_HOME" "$MIN_SKILLS" <<'PY'
import ast
import runpy
import sys
from pathlib import Path

home = Path(sys.argv[1])
min_skills = int(sys.argv[2])
router = home / "router.py"
skills_dir = home / "skills"

try:
    ast.parse(router.read_text(encoding="utf-8"))
    print("python syntax: OK")
    ns = runpy.run_path(str(router), run_name="agent_router_check")
    skills = ns["load_skills_from_dir"](skills_dir, "global")
except Exception as exc:
    print(f"installation internals: FAIL ({exc})")
    raise SystemExit(1)

print(f"skill count: {len(skills)}")
if len(skills) < min_skills:
    raise SystemExit(1)
print("skill loading: OK")
PY
  then
    pass "Installation"
  else
    fail "Installation"
  fi
}

check_routes() {
  if python3 - "$AGENT_ROUTER_HOME" <<'PY'
import json
import os
import runpy
import sys
from pathlib import Path

home = Path(sys.argv[1])
router = home / "router.py"
fixture_path = home / "tests" / "routes.json"

if not fixture_path.exists():
    print(f"route fixtures missing: {fixture_path}")
    raise SystemExit(1)

os.environ["AGENT_ROUTER_HOME"] = str(home)
ns = runpy.run_path(str(router), run_name="agent_router_check_routes")
route_prompt = ns["route_prompt"]

fixtures = json.loads(fixture_path.read_text(encoding="utf-8"))
failed = False

for item in fixtures:
    route = route_prompt(item["prompt"], Path.cwd())
    names = {skill["name"] for skill in route["selected_skills"]}
    label = item["label"]

    if route["task_class"] != item["task_class"]:
        print(f"route {label}: FAIL task_class={route['task_class']}")
        failed = True
        continue

    missing = sorted(set(item.get("include", [])) - names)
    unexpected = sorted(set(item.get("exclude", [])) & names)
    if missing or unexpected:
        print(f"route {label}: FAIL missing={missing} unexpected={unexpected}")
        failed = True
    else:
        print(f"route {label}: OK")

raise SystemExit(1 if failed else 0)
PY
  then
    pass "Routes"
  else
    fail "Routes"
  fi
}

echo "Agent Router check"
check_version
check_installation
check_routes

if [ "$ok" -eq 1 ]; then
  echo "Agent Router health: OK"
  exit 0
fi

echo "Agent Router health: FAIL"
exit 1
