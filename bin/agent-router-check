#!/usr/bin/env bash
set -euo pipefail

AGENT_ROUTER_HOME="${AGENT_ROUTER_HOME:-$HOME/.agent-router}"
VERSION_URL="${AGENT_ROUTER_VERSION_URL:-https://raw.githubusercontent.com/st-devl/Global_Router_codex/HEAD/VERSION}"
MIN_SKILLS="${AGENT_ROUTER_MIN_SKILLS:-10}"
ok=1

pass() { printf '%s: OK\n' "$1"; }
fail() { printf '%s: FAIL\n' "$1"; ok=0; }
skip() { printf '%s: SKIPPED (%s)\n' "$1" "$2"; }

local_version() {
  if [ -f "$AGENT_ROUTER_HOME/VERSION" ]; then
    tr -d '[:space:]' < "$AGENT_ROUTER_HOME/VERSION"
  else
    printf 'unknown'
  fi
}

check_version() {
  local local latest
  local="$(local_version)"
  printf 'Version local: %s\n' "$local"

  if [ "${AGENT_ROUTER_OFFLINE:-0}" = "1" ]; then
    skip "Version remote" "offline mode"
    return
  fi

  if ! command -v curl >/dev/null 2>&1; then
    skip "Version remote" "no curl"
    return
  fi

  latest="$(curl -fsSL "${VERSION_URL}?t=$(date +%s)" 2>/dev/null | tr -d '[:space:]' || true)"
  if [ -z "$latest" ]; then
    skip "Version remote" "network unavailable"
    return
  fi

  printf 'Version remote: %s\n' "$latest"
  if [ "$local" = "$latest" ]; then
    pass "Version"
  else
    printf 'Update: curl -fsSL https://raw.githubusercontent.com/st-devl/Global_Router_codex/main/install.sh | bash\n'
    fail "Version"
  fi
}

check_installation() {
  [ -x "$AGENT_ROUTER_HOME/router.py" ] && pass "router.py" || fail "router.py"

  if python3 - "$AGENT_ROUTER_HOME" "$MIN_SKILLS" <<'PY'
import ast
import runpy
import sys
from pathlib import Path

home = Path(sys.argv[1])
min_skills = int(sys.argv[2])
router = home / "router.py"
skills_dir = home / "skills"

try:
    ast.parse(router.read_text(encoding="utf-8"))
    print("python syntax: OK")
    ns = runpy.run_path(str(router), run_name="agent_router_check")
    skills = ns["load_skills_from_dir"](skills_dir, "global")
except Exception as exc:
    print(f"installation internals: FAIL ({exc})")
    raise SystemExit(1)

print(f"skill count: {len(skills)}")
if len(skills) < min_skills:
    raise SystemExit(1)
print("skill loading: OK")
PY
  then
    pass "Installation"
  else
    fail "Installation"
  fi
}

route_output() {
  python3 "$AGENT_ROUTER_HOME/router.py" "$1" 2>/dev/null || true
}

expect_route() {
  local label="$1" prompt="$2" expected="$3"
  route_output "$prompt" | grep -q "$expected" && pass "route $label" || fail "route $label"
}

reject_route() {
  local label="$1" prompt="$2" unexpected="$3"
  if route_output "$prompt" | grep -q "$unexpected"; then
    fail "route $label"
  else
    pass "route $label"
  fi
}

check_routes() {
  expect_route "auth" "Admin login yetkisini duzelt" "auth-security"
  expect_route "database" "Veritabanina yeni alan ekle" "database-safety"
  expect_route "bug" "Bug var test failed loglara bak" "bug-fix-debugging"
  expect_route "verify" "verify code and run tests" "test-validation"
  reject_route "verify-no-db" "verify code and run tests" "database-safety"
  expect_route "complex" "Karmaşık mimari değişiklik için görev listesi hazırla" "Task class: \`complex\`"
}

echo "Agent Router check"
check_version
check_installation
check_routes

if [ "$ok" -eq 1 ]; then
  echo "Agent Router health: OK"
  exit 0
fi

echo "Agent Router health: FAIL"
exit 1
