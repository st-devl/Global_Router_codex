#!/usr/bin/env bash
set -euo pipefail

AGENT_ROUTER_HOME="${AGENT_ROUTER_HOME:-$HOME/.agent-router}"
VERSION_URL="${AGENT_ROUTER_VERSION_URL:-https://raw.githubusercontent.com/st-devl/Global_Router_codex/main/VERSION}"
MIN_SKILLS="${AGENT_ROUTER_MIN_SKILLS:-10}"
ok=1

check_line() {
  local name="$1"
  local status="$2"
  printf '%s: %s\n' "$name" "$status"
}

echo "Agent Router kontrolu basliyor..."

local_version="unknown"
if [ -f "$AGENT_ROUTER_HOME/VERSION" ]; then
  local_version="$(tr -d '[:space:]' < "$AGENT_ROUTER_HOME/VERSION")"
fi
echo "Local version: $local_version"

if command -v curl >/dev/null 2>&1; then
  latest_version="$(curl -fsSL "${VERSION_URL}?t=$(date +%s)" 2>/dev/null | tr -d '[:space:]' || true)"
  if [ -n "$latest_version" ]; then
    echo "GitHub version: $latest_version"
    if [ "$local_version" = "$latest_version" ]; then
      check_line "Version" "OK"
    else
      check_line "Version" "UPDATE NEEDED"
      echo "Guncellemek icin:"
      echo "curl -fsSL https://raw.githubusercontent.com/st-devl/Global_Router_codex/main/install.sh | bash"
      ok=0
    fi
  else
    echo "GitHub version: kontrol edilemedi"
  fi
else
  echo "GitHub version: curl yok, atlandi"
fi

if [ -x "$AGENT_ROUTER_HOME/router.py" ]; then
  check_line "router.py" "OK"
else
  check_line "router.py" "FAIL"
  ok=0
fi

if python3 - "$AGENT_ROUTER_HOME" "$MIN_SKILLS" <<'PY'
import ast
import runpy
import sys
from pathlib import Path

home = Path(sys.argv[1])
min_skills = int(sys.argv[2])
router = home / "router.py"
skills_dir = home / "skills"

try:
    ast.parse(router.read_text(encoding="utf-8"))
except Exception as exc:
    print(f"python syntax: FAIL ({exc})")
    raise SystemExit(1)
print("python syntax: OK")

try:
    ns = runpy.run_path(str(router), run_name="agent_router_check")
    skills = ns["load_skills_from_dir"](skills_dir, "global")
except Exception as exc:
    print(f"skill loading: FAIL ({exc})")
    raise SystemExit(1)

print(f"skill count: {len(skills)}")
if len(skills) < min_skills:
    print("skill loading: FAIL")
    raise SystemExit(1)
print("skill loading: OK")
PY
then
  :
else
  ok=0
fi

assert_route() {
  local label="$1"
  local prompt="$2"
  local expected="$3"
  local output

  output="$(python3 "$AGENT_ROUTER_HOME/router.py" "$prompt" 2>/dev/null || true)"
  if printf '%s\n' "$output" | grep -q "$expected"; then
    check_line "route $label" "OK"
  else
    check_line "route $label" "FAIL"
    ok=0
  fi
}

assert_not_route() {
  local label="$1"
  local prompt="$2"
  local unexpected="$3"
  local output

  output="$(python3 "$AGENT_ROUTER_HOME/router.py" "$prompt" 2>/dev/null || true)"
  if printf '%s\n' "$output" | grep -q "$unexpected"; then
    check_line "route $label" "FAIL"
    ok=0
  else
    check_line "route $label" "OK"
  fi
}

assert_route "auth" "Admin login yetkisini duzelt" "auth-security"
assert_route "database" "Veritabanina yeni alan ekle" "database-safety"
assert_route "bug" "Bug var test failed loglara bak" "bug-fix-debugging"
assert_route "verify" "verify code and run tests" "test-validation"
assert_not_route "verify-no-db" "verify code and run tests" "database-safety"

if [ "$ok" -eq 1 ]; then
  echo "Agent Router saglik durumu: OK"
  exit 0
fi

echo "Agent Router saglik durumu: FAIL"
exit 1
